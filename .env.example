# ===== ОБЯЗАТЕЛЬНО =====
# Токен бота: https://discord.com/developers/applications -> твоё приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# ===== ЖЕЛАТЕЛЬНО =====
# ID твоего сервера (ПКМ по серверу -> Копировать ID сервера; нужен режим разработчика).
# Тогда команды появятся сразу, а не через час.
GUILD_ID=

# ===== МУЗЫКА =====
# Путь к ffmpeg.exe, если он не в PATH (например C:\ffmpeg\bin\ffmpeg.exe)
FFMPEG_PATH=
# Файл cookies YouTube (если YouTube пишет "Sign in to confirm you're not a bot")
COOKIES_FILE=
DEFAULT_VOLUME=50
# Через сколько секунд без музыки выходить из канала
IDLE_TIMEOUT=300
# Через сколько секунд выходить, если в канале никого не осталось
ALONE_TIMEOUT=60
# Максимум треков из одного плейлиста
MAX_PLAYLIST=200
# Выравнивание громкости по умолчанию (1 = вкл, 0 = выкл)
NORMALIZE=1
# Писать название трека в статус голосового канала (1 = да, 0 = нет)
VOICE_STATUS=1

# ===== ВЕБ-ПАНЕЛЬ и ФИЛЬМЫ =====
# 1 = включить веб-сервер (панель /panel и фильмы), 0 = выключить
WEB_ENABLED=1
# Порт веб-сервера
WEB_PORT=8080
# Адрес, по которому открывать панель. Для себя: оставь пустым (будет localhost).
# Для телефона дома: http://IP-компьютера:8080 (узнать IP: ipconfig)
# Для друзей через интернет — проброс порта на роутере или туннель (например Cloudflare Tunnel)
PUBLIC_URL=
# Пароль для панели и фильмов (добавляется в ссылки автоматически). Обязательно задай, если открываешь в интернет!
WEB_KEY=

# ===== ФИЛЬМЫ (необязательно) =====
# Папка с фильмами на компьютере, например E:\Films
FILMS_DIR=
